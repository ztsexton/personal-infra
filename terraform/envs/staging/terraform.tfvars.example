# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
# Only the Hetzner and Cloudflare values are required: this root generates its own
# SSH keypair, and scripts/staging.sh generates k3s_token and the Argo CD password
# on first run.
# Every value here already exists in the Scalr workspace or in 1Password; pull
# them from there rather than inventing new ones.

hcloud_token         = ""
cloudflare_api_token = ""


k3s_token = ""

# htpasswd -nbBC 10 admin 'yourpassword' | cut -d: -f2
argocd_admin_password_bcrypt = ""

# Leave empty to skip the 1Password bootstrap. Doing so leaves
# onepassword-operator Degraded and every OnePasswordItem-backed secret missing
# (cloudflare-api-token, zot-auth, zot-registry-credentials, ...).
onepassword_connect_token    = ""
onepassword_credentials_json = ""

cloudflare_zone_id_zachsexton    = ""
cloudflare_zone_id_petfoodfinder = ""
cloudflare_zone_id_vigilo        = ""
