# Local .terraform directories
.terraform/

# Terraform variable files containing secrets or local settings
*.tfvars
*.tfvars.json
!*.tfvars.example

# Override files for different environments
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration file
.terraformrc
terraform.rc

# Crash log files
crash.log

# Backup and plan files
*.tfstate
*.tfstate.backup
*.tfplan

# Sensitive auto-generated files
terraform.tfstate
terraform.tfstate.backup
# Terraform writes timestamped backups as terraform.tfstate.<epoch>.backup,
# which *.tfstate.backup does not match. These hold full state, private keys
# included.
*.tfstate.*.backup
sandbox.tfstate
*.log

# Kubeconfigs pulled off the servers
kubeconfig
kubeconfig-*.yaml

# Ignore IDE/editor settings (optional, but common)
.vscode/
.idea/
*.swp
*.swo

# macOS / Linux / Windows OS files
.DS_Store
Thumbs.db

*.ssh

# Local-only documentation
DATABASE-LOCAL-ACCESS.md
# Scalr / Terraform state snapshots taken by scripts/
.scalr-backups/
.tfstate-backups/

# Private keys pulled out of Terraform state by scripts/staging.sh
.ssh_key
terraform/envs/*/.ssh_key

# 1Password Connect credentials copy written by scripts/onepassword-connect.sh
1password-credentials.json*

# Python virtualenvs. Nothing here needs one -- the scripts fall back to
# system python3 -- but VS Code's python extension auto-activates any .venv it
# finds into every new integrated terminal, so keep stray ones out of the repo.
.venv/
venv/
